/* pages/car-share/car-share.wxss */

.container {
  min-height: 100vh;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 关闭按钮 */
.close-btn {
  position: absolute;
  top: 60rpx;
  right: 32rpx;
  z-index: 1000;
}

.close-icon-circle {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.close-icon {
  font-size: 48rpx;
  color: #333333;
  line-height: 1;
  font-weight: 300;
}

/* 分享卡片 */
.share-card {
  width: 100%;
  max-width: 600rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 40rpx;
}

.car-share-image {
  width: 100%;
  height: 1000rpx;
  display: block;
}

/* 分享按钮区域 */
.share-actions {
  width: 100%;
  max-width: 600rpx;
}

/* 主要分享按钮 */
.main-share-btn {
  width: 100%;
  height: 96rpx;
  background: #FF6B35;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

.main-share-btn::after {
  border: none;
}

.main-share-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.share-icon {
  width: 48rpx;
  height: 48rpx;
}

.share-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 社交平台按钮 */
.social-buttons {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.social-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 8rpx;
}

.social-btn:active {
  opacity: 0.6;
}

.social-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.social-label {
  font-size: 22rpx;
  color: #FFFFFF;
  text-align: center;
}
