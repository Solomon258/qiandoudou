<!--pages/dream-share/dream-share.wxml-->
<view class="container">
  <!-- 关闭按钮 -->
  <view class="close-btn" bindtap="closePage">
    <image class="close-icon" src="/static/icon/close-circle.png" mode="aspectFit" />
  </view>

  <!-- 分享卡片 -->
  <view class="share-card">
    <!-- 旅行分享图片 -->
    <image class="travel-share-image" src="{{travelShareImage}}" mode="aspectFill" />

    <!-- 数据卡片层 -->
    <view class="data-overlay">
      <view class="data-card">
        <!-- 顶部提示文字 -->
        <view class="top-hint">
          <text class="hint-text">撞钱计划的</text>
          <text class="hint-days">{{daysCount}}</text>
          <text class="hint-text">天</text>
        </view>

        <!-- 数据展示区域 -->
        <view class="data-row">
          <view class="data-item">
            <text class="data-value">{{transferCount}}</text>
            <text class="data-label">次数</text>
          </view>
          <view class="data-item">
            <text class="data-value">{{currentAmount}}</text>
            <text class="data-label">金额</text>
          </view>
        </view>

        <!-- 日期 -->
        <view class="date-row">
          <text class="date-text">{{currentDate}}</text>
        </view>

        <!-- 进度提示和二维码 -->
        <view class="bottom-section">
          <view class="progress-hint">
            <text class="progress-text">距离您五彩斑斓的童年</text>
            <text class="progress-percent">{{remainingPercent}}%</text>
          </view>

          <view class="qrcode-section">
            <image class="qrcode-image" src="{{qrCodeUrl}}" mode="aspectFit" />
            <text class="qrcode-hint">扫码和我一起</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 分享按钮区域 -->
  <view class="share-actions">
    <!-- 主要分享按钮 -->
    <button class="main-share-btn" open-type="share">
      <image class="share-icon" src="/static/icon/share_friend_circle.png" mode="aspectFit" />
      <text class="share-text">分享到朋友圈</text>
    </button>

    <!-- 社交平台按钮 -->
    <view class="social-buttons">
      <view class="social-btn" bindtap="onSaveImage">
        <image class="social-icon" src="/static/icon/download.png" mode="aspectFit" />
        <text class="social-label">保存图片</text>
      </view>

      <view class="social-btn" bindtap="onShareToDouyin">
        <image class="social-icon" src="/static/icon/douyin.png" mode="aspectFit" />
        <text class="social-label">抖音</text>
      </view>

      <view class="social-btn" bindtap="onShareToXiaohongshu">
        <image class="social-icon" src="/static/icon/xiaohongshu.png" mode="aspectFit" />
        <text class="social-label">小红书</text>
      </view>

      <view class="social-btn" bindtap="onShareToWeibo">
        <image class="social-icon" src="/static/icon/weibo.png" mode="aspectFit" />
        <text class="social-label">微博</text>
      </view>

      <view class="social-btn" bindtap="onShareToKuaishou">
        <image class="social-icon" src="/static/icon/kuaishou.png" mode="aspectFit" />
        <text class="social-label">快手</text>
      </view>
    </view>
  </view>
</view>
