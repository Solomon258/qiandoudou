<!--pages/buddy-group-select/buddy-group-select.wxml-->
<view class="container" wx:if="{{!loading}}">
  <view class="header">
    <text class="title">加入圈子</text>
    <text class="subtitle">你将与圈中的AI成员一起互动攒钱</text>
  </view>

  <view class="groups-list">
    <view class="group-card" wx:for="{{buddyGroups}}" wx:key="id" bindtap="selectGroup" data-id="{{item.id}}">
      <image class="group-cover" src="{{item.coverImage}}" mode="aspectFill" lazy-load="true" />
      <view class="group-info">
        <text class="group-name">{{item.name}}</text>
        <text class="group-desc">{{item.description}}</text>
        <view class="group-meta">
          <text class="member-count">{{item.memberCount}}人</text>
          <text class="arrow">></text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-container" wx:if="{{loading}}">
  <text class="loading-text">加载中...</text>
</view>
