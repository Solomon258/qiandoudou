/* pages/buddy-group-select/buddy-group-select.wxss */
.container {
  min-height: 100vh;
  background: #ffffff;
  padding: 30rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 45rpx;
  padding-top: 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.groups-list {
  margin-bottom: 60rpx;
}

.group-card {
  background: #ffffff;
  border-radius: 30rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 1rpx solid #f0f0f0;
}

.group-card:active {
  transform: scale(0.98);
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.15);
}

.group-cover {
  width: 100%;
  height: 400rpx;
  background: #f0f0f0;
}

.group-info {
  padding: 25rpx 30rpx;
}

.group-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.group-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.group-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.member-count {
  font-size: 26rpx;
  color: #999;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
}

.tips {
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid #e9ecef;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 加载状态 */
.loading-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
}
