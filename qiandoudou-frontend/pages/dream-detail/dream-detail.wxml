<!--pages/dream-detail/dream-detail.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-content">
      <text class="loading-icon">⏳</text>
      <text class="loading-text">加载中...</text>
    </view>
  </view>

  <!-- 主要内容 -->
  <view wx:else class="main-content">
    <!-- 头部视觉模块 -->
    <view class="header-visual" style="{{ isFixedTop? 'display: none;' : 'display: block;' }}">
      <!-- 限时奖励标签 -->
      <view class="reward-tag" bindtap="openChallengeModal">
        <image class="reward-icon" src="https://qiandoudou.oss-cn-guangzhou.aliyuncs.com/res/image/icon/xianshijiangli.jpg" mode="aspectFit" />
      </view>

      <!-- 显示图片（购物类型显示汽车，旅行类型显示目的地） -->
      <image class="car-image" src="{{dreamWallet.itemInfo.imageUrl}}" mode="aspectFill" bindtap="previewImage" />
    </view>

    <!-- 进度与目标展示模块 -->
    <view class="progress-target-section" style="{{ isFixedTop? 'display: none;' : 'display: block;' }}">
      <!-- 已攒金额 -->
      <view class="amount-display">
        <text class="current-amount">{{dreamWallet.formattedCurrentAmount}}</text>
        <text class="amount-label">已攒梦想基金(元)</text>
      </view>

      <!-- 进度条和节点 -->
      <view class="progress-container">
        <view class="progress-bar-wrapper">
          <view class="progress-bar-bg">
            <view class="progress-bar-fill" style="width: {{progress.percentage}}%"></view>
          </view>
          <!-- 进度节点徽章 -->
          <view class="progress-badges">
            <view wx:for="{{progressBadges}}" wx:key="index" class="badge-item" style="left: {{item.position}}%"
              bindtap="onBadgeTap" data-index="{{index}}" data-badge="{{item}}">
              <image wx:if="{{item.completed}}" class="badge-icon completed" src="{{item.activeIcon}}" />
              <image wx:else class="badge-icon" src="{{item.inactiveIcon}}" />
            </view>
          </view>
        </view>
        <!-- 百分比和目标金额 -->
        <view class="progress-labels">
          <text class="progress-percentage">{{progress.percentage}}%</text>
          <text class="target-amount">¥{{dreamWallet.formattedTargetAmount}}</text>
        </view>
      </view>
    </view>

    <!-- 旅行行程模块（仅旅行类型显示） -->
    <view wx:if="{{dreamWallet.dreamType === 2}}" class="{{ isFixedTop ? 'title-to-top travel-itinerary-section' : 'travel-itinerary-section' }}">
      <!-- 行程标题 -->
      <view wx:if="{{dreamWallet.dreamItineraryTitle}}" class="{{ isFixedTop ?'itinerary-title-top' : 'itinerary-title'}}">
        <text class="title-text">{{dreamWallet.dreamItineraryTitle}}</text>
      </view>

      <view class="{{ isFixedTop ?'itinerary-scroll-top' : 'itinerary-scroll'}}">
        <view class="itinerary-content">
          <rich-text class="itinerary-rich-text"
            nodes="{{dreamWallet.dreamItineraryHtml || 'AI正在为您生成详细的旅行行程，请稍后刷新查看...'}}" user-select></rich-text>
        </view>
      </view>
    </view>

    <!-- 账单流水模块 -->
    <view class="records-section">
      <view wx:for="{{records}}" wx:key="id" class="record-card">
        <!-- ✅ 用户头像 -->
        <image wx:if="{{item.userAvatar}}" class="record-avatar" src="{{item.userAvatar}}" mode="aspectFill" />

        <view class="record-left">
          <text class="record-title">{{item.typeText}}</text>
          <text class="record-time">{{item.createTime}}</text>
        </view>
        <view class="record-right">
          <text class="record-amount {{item.type === 'out' ? 'negative' : 'positive'}}">{{item.amountText}}</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{records.length === 0 && !loadingRecords}}" class="empty-records">
        <text class="empty-text">暂无攒钱记录</text>
      </view>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-action">
    <button class="deposit-btn" bindtap="goToDeposit">
      <view class="btn-content">
        <image class="deposit-icon" src="/static/icon/xingqiu.jpg" />
        <text class="deposit-text">去攒钱</text>
      </view>
    </button>
  </view>

  <!-- 限时挑战弹窗 -->
  <view class="challenge-modal-mask {{showChallengeModal ? 'show' : ''}}" bindtap="closeChallengeModal"
    catchtouchmove="preventTouchMove">
    <view class="challenge-modal {{showChallengeModal ? 'show' : ''}}" catchtap="stopPropagation">
      <image src="/static/icon/activity/time_changel.png" class="bg_time" mode="" />
      <!-- 弹窗头部 -->
      <view class="challenge-header">
        <!-- <image class="header-icon-left" src="https://qiandoudou.oss-cn-guangzhou.aliyuncs.com/res/image/dream/activity/clock.jpg" mode="aspectFit" />
        <text class="challenge-title">限时挑战</text>
        <image class="header-icon-right" src="https://qiandoudou.oss-cn-guangzhou.aliyuncs.com/res/image/dream/activity/coins.jpg" mode="aspectFit" /> -->
        <view class="close-btn" bindtap="closeChallengeModal">
          <text class="close-icon">×</text>
        </view>
      </view>
      <view class="time-content">
        <!-- 倒计时 -->
        <view class="countdown-section">
          <text class="countdown-text">距离结束仅剩 {{countdown}}</text>
        </view>

        <!-- 挑战卡片列表 -->
        <view class="challenge-cards">
          <!-- 挑战1 -->
          <view class="challenge-card active">
            <image class="card-icon"
              src="https://qiandoudou.oss-cn-guangzhou.aliyuncs.com/res/image/dream/activity/youhuiquan.jpg"
              mode="aspectFit" />
            <view class="card-header">
              <text class="card-title">挑战 1</text>
            </view>
         
            <text class="card-reward">叠加1%券</text>
            <view class="card-status">
              <text>进行中</text>
            </view>
          </view>

          <!-- 挑战2 -->
          <view class="challenge-card active">
            <view class="card-header">
              <text class="card-title">挑战 2</text>
            </view>
            <image class="card-icon"
              src="https://qiandoudou.oss-cn-guangzhou.aliyuncs.com/res/image/dream/activity/lihe.jpg"
              mode="aspectFit" />
            <text class="card-reward">汽车贷款减免金</text>
            <view class="card-status lock-text">待解锁</view>
          </view>

          <!-- 挑战3 -->
          <view class="challenge-card active">
            <view class="card-header">
              <text class="card-title">挑战 3</text>
            </view>
            <image class="card-icon"
              src="https://qiandoudou.oss-cn-guangzhou.aliyuncs.com/res/image/dream/activity/youhuiquan.jpg"
              mode="aspectFit" />
            <text class="card-reward">叠加2%券</text>
            <view class="card-status lock-text">待解锁</view>
          </view>
        </view>

        <!-- 任务详情 -->
        <view class="task-detail">
          <text class="task-title">挑战1:完成以下任务得年收益叠加1%券</text>

          <!-- 任务1: 剧本攒 -->
          <view class="task-item">
            <image class="task-icon"
              src="https://qiandoudou.oss-cn-guangzhou.aliyuncs.com/res/image/dream/activity/jubenzan.jpg"
              mode="aspectFit" />
            <text class="task-desc">剧本攒完成3章内容</text>
            <button class="task-btn" bindtap="goToScriptList">去完成</button>
          </view>

          <!-- 分割线 -->
          <view class="task-divider"></view>

          <!-- 任务2: 邀请好友 -->
          <view class="task-item">
            <image class="task-icon"
              src="https://qiandoudou.oss-cn-guangzhou.aliyuncs.com/res/image/dream/activity/email.jpg"
              mode="aspectFit" />
            <text class="task-desc">邀请一个成员为你助力</text>
            <button class="task-btn" bindtap="openSharePage">邀请</button>
          </view>
        </view>
      </view>

    </view>
  </view>
</view>