/* pages/dream-detail/dream-detail.wxss */

/* 容器和布局 */
.container {
  background: #FFFFFF;
  min-height: 100vh;
  padding-bottom: 120rpx; /* 为底部按钮留出空间 */
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-icon {
  font-size: 40rpx;
  animation: rotate 1s linear infinite;
}

.loading-text {
  font-size: 24rpx;
  color: #666666;
  margin-top: 20rpx;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 主要内容 */
.main-content {
  padding-top: 0;
}

/* 头部视觉模块 */
.header-visual {
  position: relative;
  background: linear-gradient(180deg, #8B7CF6 0%, #A78BFA 100%);
  padding: 0;
  height: 500rpx;
  width: 100%;
  overflow: hidden;
}

.reward-tag {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  border-radius: 8rpx;
  z-index: 10;
}

.reward-icon {
  width: 160rpx;
  height: 80rpx;
  display: block;
}

.reward-text {
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 1;
}

.car-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 进度与目标展示模块 */
.progress-target-section {
  background: #FFFFFF;
  padding: 24rpx 32rpx;
}

.amount-display {
  text-align: center;
  margin-bottom: 24rpx;
}

.current-amount {
  font-size: 48rpx;
  color: #000000;
  font-weight: 600;
  line-height: 1.2;
  display: block;
}

.amount-label {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.2;
  margin-top: 8rpx;
  display: block;
}

.progress-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.progress-bar-wrapper {
  width: 100%;
  position: relative;
}

.progress-bar-bg {
  width: 100%;
  height: 16rpx;
  background: #EEEEEE;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #FF6B35;
  border-radius: 8rpx;
  transition: width 0.3s ease;
  min-width: 16rpx;
}

.progress-badges {
  position: absolute;
  top: -16rpx;
  left: 0;
  right: 0;
  height: 48rpx;
}

.badge-item {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
}

.badge-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.badge-icon.completed {
  transform: scale(1.1);
}

/* 进度标签（百分比和目标金额） */
.progress-labels {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-percentage {
  font-size: 28rpx;
  color: #666666;
}

.target-amount {
  font-size: 28rpx;
  color: #000000;
  text-align: right;
}

/* 账单流水模块 */
.records-section {
  padding: 0 32rpx 24rpx;
}

.record-card {
  background: #FFFFFF;
  border: 2rpx solid #EEEEEE;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 160rpx;
  box-sizing: border-box;
}

.record-left {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.record-title {
  font-size: 32rpx;
  color: #000000;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.2;
}

.record-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.2;
}

.record-amount.positive {
  color: #FF6B35;
}

.record-amount.negative {
  color: #4CAF50;
}

/* 空状态 */
.empty-records {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  line-height: 1.2;
}

/* 底部操作按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 48rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EEEEEE;
}

.deposit-btn {
  width: 100% !important;
  height: 88rpx;
  background: #FF6B35;
  border-radius: 44rpx;
  border: none;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}

.deposit-btn::after {
  border: none;
}

.deposit-btn:active {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.btn-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.deposit-icon {
  width: 40rpx;
  height: 40rpx;
}

.deposit-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1.2;
}

/* 旅行行程区域 */
.travel-itinerary-section {
  padding: 0 32rpx 24rpx;
  background: #FFFFFF;
}

.itinerary-title {
  padding: 24rpx 0 16rpx;
  margin-bottom: 16rpx;
}

.title-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.4;
}

.itinerary-scroll {
  max-height: 800rpx;
  background: linear-gradient(180deg, rgba(135, 206, 235, 0.1) 0%, rgba(255, 255, 255, 0.95) 100%);
  border-radius: 16rpx;
  padding: 24rpx;
}

.itinerary-content {
  width: 100%;
}

.itinerary-rich-text {
  width: 100%;
  font-size: 28rpx;
  line-height: 2.2;
  color: #333333;
  word-wrap: break-word;
  word-break: break-word;
}

/* 限时挑战弹窗 */
.challenge-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  visibility: hidden;
  transition: background 0.3s ease;
}

.challenge-modal-mask.show {
  background: rgba(0, 0, 0, 0.5);
  visibility: visible;
}

.challenge-modal {
  width: 100%;
  max-height: 85vh;
  /* background: linear-gradient(180deg, #FFF5F0 0%, #FFFFFF 100%); */
  border-radius: 32rpx 32rpx 0 0;
  /* padding: 40rpx 32rpx; */
  /* padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); */
  transform: translateY(100%);
  transition: transform 0.3s ease;
  overflow-y: auto;
  position: relative;
}

.challenge-modal.show {
  transform: translateY(0);
}

/* 弹窗头部 */
.challenge-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 24rpx;
}

.header-icon-left {
  width: 80rpx;
  height: 80rpx;
  margin-right: 16rpx;
}

.challenge-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #000000;
}

.header-icon-right {
  width: 100rpx;
  height: 100rpx;
  margin-left: 16rpx;
}

.close-btn {
  position: absolute;
  top: 8rpx;
  right: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 56rpx;
  color: #fff;
  line-height: 1;
}

/* 倒计时 */
.countdown-section {
  /* background: linear-gradient(90deg, #FFE5D9 0%, #FFD4C4 100%); */
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
  text-align: left;
  padding-top: 160rpx;
  z-index: 999;
}

.countdown-text {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 500;
  background: rgba(255,107,53,0.2);
}

/* 挑战卡片 */
.challenge-cards {
  display: flex;
  gap: 20rpx;
  /* margin-bottom: 32rpx; */
  overflow-x: auto;
}

.challenge-card {
  flex-shrink: 0;
  flex: 1;
  height: 260rpx;
  /* background: linear-gradient(180deg, #FFD700 0%, #FFA500 100%) ; */
  /* border-radius: 16rpx ; */
  /* padding: 16rpx 12rpx 20rpx ; */
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  /* border: 4rpx solid #FFD700 ; */
  overflow: hidden;
}

.challenge-card.active {
  /* background: linear-gradient(180deg, #FFD700 0%, #FFA500 100%);
  border-color: #FF6B35;
  box-shadow: 0 8rpx 16rpx rgba(255, 107, 53, 0.3); */
  
}

.challenge-card.locked {
  background: linear-gradient(180deg, #FFE5B4 0%, #FFD98E 100%);
  opacity: 0.7;
}

.card-header {
  position: absolute;
  top: 12rpx;
  left: calc(50% - 52rpx);
  z-index: 999;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
}

.card-title {
  font-size: 24rpx;
  /* font-weight: bold; */
  color: #FFFFFF;
  background: #FF6B35;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  /* display: inline-block; */
}

.card-icon {
  /* width: 100%;
  height: 140rpx;
  margin-bottom: 8rpx;
  object-fit: contain;
  z-index: 1; */
  height: 260rpx;
}

.card-reward {
  font-size: 24rpx;
  color: #FF6B35;
  /* font-weight: 600; */
  text-align: center;
  margin-bottom: 8rpx;
  line-height: 1.2;
  z-index: 2;
  position: absolute;
  top: 47rpx;
}

.card-status {
  /* background: #FF6B35; */
  color: #FF6B35;
  font-size: 22rpx;
  /* padding: 6rpx 16rpx ; */
  /* border-radius: 20rpx ; */
  font-weight: 500;
  z-index: 2;
  width: 100%;
  text-align: center;
  position: absolute;
  bottom: 30rpx;
}
.lock-text {
  color: #987373;
}
.challenge-card.locked .card-status {
  background: #999999;
}

/* 任务详情 */
.task-detail {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  z-index: 999;
  margin-top: 20rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5d3914;
  display: block;
  margin-bottom: 32rpx;
  line-height: 1.4;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.task-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.task-desc {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
}

.task-btn {
  background: #FF6B35;
  color: #FFFFFF;
  font-size: 26rpx;
  padding: 16rpx 8rpx;
  border-radius: 40rpx;
  border: none;
  font-weight: 500;
  flex-shrink: 0;
  width: 130rpx !important;
  height: auto;
  line-height: 1.2;
}

.task-btn::after {
  border: none;
}

.task-btn:active {
  opacity: 0.8;
}

.task-divider {
  height: 1rpx;
  background: #EEEEEE;
  margin: 8rpx 0;
}
.bg_time {
  position: fixed;
  object-fit: cover;
  height: 85vh;
  width: 100%;
}
.time-content {
  display: flex;
  flex-direction: column;
  padding: 40rpx;
}