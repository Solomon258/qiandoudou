/* pages/dream-create/dream-create.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0;
  display: flex;
  flex-direction: column;
}

/* 顶部展示区域 */
.header-section {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
}

.item-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 40rpx;
  backdrop-filter: blur(10px);
}

.item-image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.item-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.item-landmark {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 表单区域 */
.form-section {
  background: #ffffff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  margin-top: 20rpx;
  flex: 1;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #667eea;
  background: #ffffff;
}

.form-input::placeholder {
  color: #adb5bd;
}

/* 提示信息 */
.tip-section {
  padding: 20rpx 40rpx;
  background: #ffffff;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #666666;
  text-align: center;
  line-height: 1.5;
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
}

/* 按钮区域 */
.button-section {
  padding: 20rpx 40rpx 40rpx;
  background: #ffffff;
}

.create-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s ease;
}

.create-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.create-btn[disabled] {
  background: #adb5bd;
  box-shadow: none;
  transform: none;
}