<!--pages/dream-shopping-select/dream-shopping-select.wxml-->
<view class="container">
  <text style="color: white; font-size: 32rpx; text-align: center; display: block; margin: 50rpx 0;">选择购物梦想</text>
  
  <!-- 简单的商品列表 - 点击触发弹框 -->
  <view style="padding: 50rpx;">
    <view wx:for="{{dreamItems}}" wx:key="id" 
          style="background: white; margin: 20rpx 0; padding: 30rpx; border-radius: 10rpx; display: flex; align-items: center;"
          data-id="{{item.id}}" bindtap="selectItem">
      <image src="{{item.imageUrl}}" style="width: 60rpx; height: 60rpx; margin-right: 20rpx;" mode="aspectFit" />
      <view>
        <text style="font-size: 28rpx; color: #333;">{{item.displayName}}</text>
        <text style="font-size: 24rpx; color: #666; display: block;">¥{{item.suggestedAmount}}</text>
      </view>
    </view>
  </view>

  <!-- 购物梦想弹框 -->
  <view class="modal-overlay" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal-content" catchtap="">
      <!-- 弹框头部 -->
      <view class="modal-header">
        <text class="modal-title">选择轿车</text>
        <image class="modal-icon" src="/static/icon/goods/轿车@3x.png" mode="aspectFit" />
      </view>

      <!-- 梦想名称输入 -->
      <view class="modal-section">
        <text class="modal-label">请输入梦想攒的名称</text>
        <input 
          class="modal-input" 
          placeholder="XXX的钱包" 
          value="{{modalData.walletName}}" 
          bindinput="onWalletNameInput" 
          maxlength="20" />
      </view>

      <!-- 车型选择 -->
      <view class="modal-section">
        <view class="car-types">
          <view 
            wx:for="{{modalData.carTypes}}" 
            wx:key="*this" 
            class="car-type-item {{modalData.selectedCarType === item ? 'selected' : ''}}"
            data-type="{{item}}"
            bindtap="selectCarType">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 金额输入 -->
      <view class="modal-section">
        <text class="modal-label">请输入梦想攒的金额</text>
        <input 
          class="modal-input" 
          placeholder="¥1" 
          value="{{modalData.targetAmount}}" 
          bindinput="onTargetAmountInput" 
          type="digit" />
      </view>

      <!-- 快捷金额选择 -->
      <view class="modal-section">
        <view class="quick-amounts">
          <view 
            wx:for="{{modalData.quickAmounts}}" 
            wx:key="*this" 
            class="quick-amount-item"
            data-amount="{{item}}"
            bindtap="selectQuickAmount">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- 按钮区域 -->
      <view class="modal-buttons">
        <button class="modal-btn cancel-btn" bindtap="closeModal">取消</button>
        <button class="modal-btn confirm-btn" bindtap="confirmCreate">确认</button>
      </view>
    </view>
  </view>
</view>