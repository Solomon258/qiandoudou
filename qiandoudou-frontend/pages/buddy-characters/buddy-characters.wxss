/* pages/buddy-characters/buddy-characters.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
}

/* 顶部导航 */
.header {
  padding: calc(20rpx + env(safe-area-inset-top)) 40rpx 20rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  margin-right: 20rpx;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  flex: 1;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 内容区域 */
.content {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 120rpx - env(safe-area-inset-top));
}

/* 角色展示区 */
.character-display {
  position: relative;
  height: 500rpx;
  margin: 0 40rpx 40rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.character-bg {
  width: 100%;
  height: 100%;
}

.character-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 60rpx 40rpx 40rpx;
}

.character-info {
  color: #ffffff;
}

.character-name {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  display: block;
}

.character-tags {
  margin-bottom: 16rpx;
}

.tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.character-intro {
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: block;
  opacity: 0.9;
}

.voice-btn {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  width: fit-content;
}

.voice-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.voice-text {
  font-size: 28rpx;
  color: #ffffff;
}

/* 角色选择器 */
.character-selector {
  margin-bottom: 40rpx;
}

.character-swiper {
  height: 200rpx;
}

.character-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin: 0 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.character-card.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  transform: scale(1.05);
}

.character-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-bottom: 12rpx;
}

.character-name-small {
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.character-card.selected .character-name-small {
  color: #ffffff;
}

.select-indicator {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 已选预览 */
.selected-preview {
  background: #ffffff;
  margin: 0 40rpx 40rpx;
  border-radius: 24rpx;
  padding: 32rpx;
}

.preview-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.preview-count {
  font-size: 28rpx;
  color: #666666;
  margin-left: 8rpx;
}

.selected-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.selected-item {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 32rpx;
  padding: 12rpx 20rpx;
  position: relative;
}

.selected-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.selected-name {
  font-size: 26rpx;
  color: #333333;
  margin-right: 8rpx;
}

.remove-btn {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  width: 20rpx;
  height: 20rpx;
}

.empty-selection {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 确认按钮 */
.confirm-section {
  padding: 0 40rpx calc(40rpx + env(safe-area-inset-bottom));
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  background: #cccccc;
  color: #666666;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn.enabled {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.confirm-btn[disabled] {
  background: #cccccc;
  color: #666666;
}
