<!--pages/buddy-circles/buddy-circles.wxml-->
<view class="container">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="nav-bar">
      <view class="back-btn" bindtap="goBack">
        <image class="back-icon" src="/static/icon/arrow_left.svg"/>
      </view>
      <text class="nav-title">选择圈子</text>
    </view>
    
    <view class="header-content">
      <text class="main-title">加入经典IP圈子</text>
      <text class="sub-title">选择你喜欢的角色圈子，开启团队攒钱之旅</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 圈子列表 -->
  <view wx:else class="circles-list">
    <view wx:for="{{circles}}" wx:key="id" class="circle-card" bindtap="selectCircle" data-circle="{{item}}">
      <image class="circle-cover" src="{{item.coverImage}}" mode="aspectFill"/>
      
      <view class="circle-content">
        <view class="circle-info">
          <text class="circle-name">{{item.name}}</text>
          <text class="circle-desc">{{item.description}}</text>
        </view>
        
        <!-- 成员预览 -->
        <view class="circle-members">
          <view class="member-avatars">
            <image wx:for="{{item.memberPreview}}" wx:for-item="member" wx:key="name"
                   class="member-avatar" src="{{member.avatar}}" mode="aspectFill"/>
          </view>
          <text class="member-count">{{item.memberCount}}人团队</text>
        </view>
        
        <view class="join-btn">
          <text class="join-text">加入圈子</text>
          <image class="arrow-icon" src="/static/icon/arrow_right.svg"/>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && circles.length === 0}}" class="empty-state">
    <image class="empty-icon" src="/static/icon/empty.svg"/>
    <text class="empty-text">暂无可用圈子</text>
    <text class="empty-desc">请稍后再试或选择自由选搭模式</text>
  </view>
</view>
