/* pages/transfer-out/transfer-out.wxss */
.container {
  min-height: 100vh;
  background: #f1f2f3;
  padding-bottom: 120px;
}

/* 顶部导航 */
.top-nav {
  display: flex;
  align-items: center;
  height: 48px;
  background: #f1f2f3;
  padding: 0 16px;
  position: relative;
  z-index: 100;
  margin-top: 100rpx;
}

.nav-left {
  /* display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px; */
}

.back-btn {
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 36px;
  line-height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  display: block;
  width: 48px;
  height: 48px;
  color: rgba(0, 0, 0, 0.9);
  font-weight: 300;
}

.nav-right {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-center {
  /* flex: 1;
  display: flex;
  justify-content: center;
  align-items: center; */
}

.nav-title {
  font-size: 18px;
  color: rgba(0, 0, 0, 0.9);
}

.back-icon {
  font-size: 20px;
  color: #000;
  font-weight: 300;
}

/* 转出至区域 */
.transfer-to-section {
  margin: 20px 16px 0 16px;
  padding: 16px 16px 0;
  border-radius: 12px;
}

.section-title {
  font-size: 16px;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 16px;
  display: block;
}

.bank-card-item {
  background: #ffffff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bank-card-item.active {
  border: 2px solid #FA6402;
}

.bank-info {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
}

.bank-logo {
  width: 40px;
  height: 24px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bank-logo.pingan {
  background: #FA6402;
}

.bank-logo.other {
  background: #FA6402;
}

.bank-text {
  font-size: 10px;
  color: #ffffff;
  font-weight: 600;
}

.bank-icon {
  font-size: 16px;
}

.bank-details {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bank-name {
  font-size: 16px;
  color: #000;
  font-weight: 500;
}

.bank-action {
  font-size: 14px;
  color: #FA6402;
}

.expand-icon {
  margin-left: 8px;
}

.arrow-down {
  font-size: 16px;
  color: #FA6402;
  transform: rotate(90deg);
  transition: transform 0.3s ease;
}

.arrow-down.open {
  transform: rotate(-90deg);
}

/* 钱包列表 */
.wallet-list {
  background: #ffffff;
  border-radius: 0 0 12px 12px;
  margin: -8px 0 12px 0;
  overflow: hidden;
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.wallet-item {
  padding: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #f0f0f0;
}

.wallet-item:first-child {
  border-top: none;
}

.wallet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.wallet-name {
  font-size: 14px;
  color: #000;
  font-weight: 500;
}

.wallet-balance {
  font-size: 12px;
  color: #999;
}

.wallet-check {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #FA6402;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12px;
}

.check-mark {
  color: #ffffff;
  font-size: 12px;
  font-weight: 600;
}

/* 空状态提示 */
.empty-wallet-tip {
  background: #ffffff;
  border-radius: 0 0 12px 12px;
  padding: 20px 16px;
  text-align: center;
  margin: -8px 0 12px 0;
}

.empty-text {
  font-size: 14px;
  color: #999;
}

/* 转出金额区域 */
.amount-section {
  padding: 0 16px;
  margin-bottom: 20px;
}

.amount-card {
  background: #ffffff;
  border-radius: 12px;
  padding: 20px;
}

.amount-title {
  font-size: 16px;
  font-weight: 600;
  color: #000;
  margin-bottom: 20px;
  display: block;
}

.amount-input-container {
  display: flex;
  align-items: center;
  gap: 8px;
}

.currency {
  font-size: 24px;
  font-weight: 600;
  color: #000;
}

.amount-input {
  flex: 1;
  font-size: 16px;
  color: #999;
  border: none;
  outline: none;
  background: transparent;
}

.amount-input::placeholder {
  color: #999;
  font-size: 14px;
}

.all-text {
  font-size: 12px;
  color: #FA6402;
  font-weight: 500;
}

/* 备注区域 */
.note-section {
  padding: 0 16px;
}

.note-card {
  background: #ffffff;
  border-radius: 12px;
  padding: 20px;
}

.note-title {
  font-size: 16px;
  color: rgba(0, 0, 0, 0.9);
  margin-bottom: 16px;
  display: block;
}

.note-textarea {
  width: 100%;
  min-height: 100px;
  font-size: 14px;
  color: #000;
  line-height: 1.6;
  border: none;
  outline: none;
  background: transparent;
  resize: none;
  margin-bottom: 16px;
}

.note-textarea::placeholder {
  color: #999;
}

.note-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.retry-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  border: 1px solid #FA6402;
  border-radius: 16px;
  background: transparent;
}

.retry-btn:active {
  background: #fff5f0;
}

.retry-icon {
  font-size: 14px;
}

.retry-text {
  font-size: 14px;
  color: #FA6402;
  font-weight: 500;
}

.char-count {
  font-size: 12px;
  color: #999;
}

/* 图片区域 */
.image-section {
  display: flex;
  gap: 12px;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width:82px;
  height:78px;
  border-radius:4px;
  background:rgba(0, 0, 0, 0.05);
  border-radius:4px;
}

.camera-icon {
  width: 24px;
  height: 24px;
}

.uploaded-image-container {
  position: relative;
  width: 120px;
  height: 120px;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 8px;
}

.image-tag {
  position: absolute;
  bottom: 8px;
  right: 8px;
  width: 24px;
  height: 24px;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-text {
  font-size: 12px;
  color: #fff;
  font-weight: 600;
}

/* 底部确认按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px 16px;
  background: #fff;
  border-top: 1px solid #f0f0f0;
  z-index: 100;
}

.confirm-btn {
  width: 100% !important;
  height: 52px;
  background: #FA6402;
  border: none;
  border-radius: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn:disabled {
  background: #ccc;
}

.confirm-btn:not(:disabled):active {
  background: #357ABD;
}

.btn-text {
  font-size: 16px;
  color: #ffffff;
  font-weight: 600;
}
