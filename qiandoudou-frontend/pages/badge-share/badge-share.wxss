/* pages/badge-share/badge-share.wxss */
.container {
  height: 100vh;
  background: rgba(0, 0, 0, 0.6);
  padding: 60px 20px 40px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 卡片容器 */
.card-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

/* 关闭按钮 */
.close-btn {
  position: absolute;
  top: -80rpx;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  width: 64rpx;
  height: 64rpx;
  filter: drop-shadow(0 2rpx 8rpx rgba(0, 0, 0, 0.3));
}

/* 分享卡片 */
.share-card {
  position: relative;
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}
.share-card-info {
  position: absolute;
  left: 50%;
  bottom: 20px;
  border-radius: 8px;
  width: calc(100% - 20px);
  margin: 0 10px;
  background: rgba(255,255,255,0.8);
  transform: translateX(calc(-50% - 10px));
  display: flex;
  justify-content: space-between;
  padding: 10px;
  box-sizing: border-box;
}
.share-card-info-right {
  display: flex;
  justify-content: space-between;
  gap: 10px;
}
/* 汽车图片容器 */
.car-image-container {
  position: relative;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #8B7CF6 0%, #A78BFA 100%);
}

.car-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.badge-tag {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.6);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* 梦想信息 */
.dream-info {
  padding: 20rpx 32rpx 20rpx;
  text-align: center;
}

.dream-title {
  font-size: 28rpx;
  color: #666666;
  display: block;
}

.amount {
  font-family: PingFangSC-Semibold;
  font-size: 24px;
  color: #000000;
  font-weight: 600;
  line-height: 33px;
  display: block;
}

.amount-label {
  font-family: PingFangSC-Regular;
  font-size: 10px;
  color: rgba(0,0,0,0.90);
  text-align: left;
  font-weight: 400;
}

/* 激励文案 */
.motivation-text {
  padding: 0 32rpx 0;
}

.motivation {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  text-align: center;
  display: block;
}

.share-card-info-left {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.date {
  font-family: PingFangSC-Regular;
  font-size: 16px;
  color: rgba(0,0,0,0.85);
  font-weight: 400;
  line-height: 22px;
}



.qr-code {
  width: 68px;
  height: 68px;
}

.qr-text {
  text-align: right;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  font-family: PingFangSC-Regular;
  font-size: 10px;
  color: rgba(0,0,0,0.60);
  font-weight: 400;
}

/* 底部按钮区域 */
.bottom-actions {
  width: 100%;
  margin-top: 15px;
  display: flex;
  flex-direction: column;
}

/* 主分享按钮 */
.bottom-actions .share-btn {
  width: 100%;
  height: 56px;
  background: #FF7214;
  border-radius: 12px;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.3);
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  filter: brightness(0) invert(1);
}

.btn-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 其他分享选项 */
.share-options {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 100%;
  padding: 0 20rpx;
  margin-top: 40rpx;
}

.share-option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.share-option-item:active {
  opacity: 0.7;
}

.option-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F5F5F5;
}

.option-text {
  font-size: 22rpx;
  color: #FFFFFF;
  text-align: center;
}
